# RAG-MCP 环境变量模板
# 复制本文件为 .env 并填入真实值。.env 不应提交到版本库。
# settings.yaml 中通过 *_api_key_env 字段引用以下变量名。

# --- 必填（默认配置下启动服务所需） ---

# DeepSeek LLM API Key（用于生成式问答）
# 获取：https://platform.deepseek.com/
# settings.yaml 引用：llm.api_key_env
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 智源 AI Embedding API Key（用于文档向量化与查询向量化）
# 获取：https://open.bigmodel.cn/
# settings.yaml 引用：embedding_provider.api_key_env
ZHIPU_API_KEY=your_zhipu_api_key_here

# --- 可选 ---

# OpenAI 兼容 API Base URL（用于接入外部 LLM 网关，如 Synapse / LiteLLM proxy）
# 设置后会覆盖 settings.yaml 中 llm.api_base 的默认值
# 格式示例：https://api.openai.com/v1 或 https://your-gateway.example.com/v1
# 详情见 docs/开发方向调整.md §4 标准集成架构
OPENAI_API_BASE=

# OpenAI API Key（默认配置下 vision_llm 已禁用，不依赖此变量）
# 仅当 settings.yaml 中 vision_llm.provider 启用时需要
# 获取：https://platform.openai.com/
OPENAI_API_KEY=

# Reranker API Key（仅当 settings.yaml 中 rerank.provider 切换为需要密钥的厂商时填写）
# 默认 rerank.provider=lexical，不依赖此变量
RERANK_API_KEY=

# Redis 密码（仅当启用 Redis 缓存且 Redis 设置了密码时填写）
# settings.yaml 引用：redis.password_env
REDIS_PASSWORD=
