app:
  name: "rag-mcp"
  environment: "development"

embedding:
  provider: "zhipu"
  dimensions: 2048

embedding_provider:
  api_base: "https://open.bigmodel.cn/api/paas/v4"
  api_key_env: "ZHIPU_API_KEY"
  model: "embedding-3"
  timeout_seconds: 30.0

llm:
  provider: "deepseek"       # 底层使用 OpenAICompatibleLlmProvider（任意 OpenAI 兼容 /chat/completions 端点均可）
  enabled: true
  # ── api_base 说明 ────────────────────────────────
  # 最终请求 URL = {api_base}/chat/completions
  #
  # 直连供应商示例：
  #   DeepSeek:  https://api.deepseek.com
  #   OpenAI:    https://api.openai.com/v1     ← 注意：必须包含 /v1
  #
  # 经外部 LLM 网关示例（详见 docs/integration-guide.md）：
  #   LiteLLM:   http://localhost:4000/v1
  #   Synapse:   https://your-synapse.example.com/v1
  #   OpenRouter: https://openrouter.ai/api/v1
  #
  # 通过 .env 中的 OPENAI_API_BASE 可覆盖此值（需代码层面支持）
  api_base: "https://api.deepseek.com"
  api_key_env: "DEEPSEEK_API_KEY"
  model: "deepseek-chat"
  temperature: 0.1
  max_tokens: 1024
  timeout_seconds: 60.0

vision_llm:
  provider: "disabled"
  enabled: false
  api_base: null
  api_key_env: "OPENAI_API_KEY"
  model: null
  timeout_seconds: 60.0

vector_store:
  provider: "chroma"            # "chroma"（默认，零依赖，全平台）| "weaviate" | "memory"
  collection_name: "rag_mcp_live"
  persist_path: "data/vector_store/chroma_live"

  # ── Weaviate 连接模式（仅 provider: "weaviate" 时生效）────────────
  # "embedded": 进程内启动 Weaviate（Linux/macOS 可用，Windows 不支持）
  # "remote":   连接外部 Weaviate（Docker 容器 / Weaviate Cloud），全平台可用
  weaviate_mode: "embedded"

  # Embedded 模式专用（仅 weaviate_mode == "embedded" 时生效）
  weaviate_persistence_data_path: "data/vector_store/weaviate"
  weaviate_version: "1.37.2"
  weaviate_hostname: "127.0.0.1"
  weaviate_port: 8079

  # Remote 模式专用（仅 weaviate_mode == "remote" 时生效）
  weaviate_grpc_port: 50051
  weaviate_api_key: null          # Weaviate Cloud 需要 API Key

ingestion:
  chunk_size: 500
  chunk_overlap: 50
  normalize_whitespace: true
  preserve_paragraph_breaks: true
  boundary_scan_chars: 80
  min_chunk_length: 40
  max_file_size_bytes: 20971520
  allow_hidden_files: false
  supported_extensions:
    - ".txt"
    - ".md"
    - ".pdf"
    - ".html"
    - ".htm"

retrieval:
  top_k: 5
  dense_top_k: 5
  sparse_top_k: 5
  hybrid_top_k: 5
  rrf_k: 60
  rerank_enabled: true
  rerank_top_k: 5

rerank:
  provider: "lexical"
  enabled: true
  model: null
  api_base: null
  api_key_env: "RERANK_API_KEY"
  score_threshold: null
  timeout_seconds: 30.0

observability:
  trace_enabled: true
  trace_path: "data/traces/traces.jsonl"

evaluation:
  enabled: true
  report_path: "data/evaluations/reports.jsonl"
  default_test_set_path: "data/evaluations/golden_test_set.json"
  metrics:
    - "hit_rate"
    - "mrr"
  top_k: 5
  persist_reports: true

prompts:
  answer_system_prompt_path: "config/prompts/answer_system.txt"
  answer_user_prompt_path: "config/prompts/answer_user.txt"

mcp:
  server_name: "rag-mcp"
  server_version: "0.1.0"
  transport: "streamable-http"  # "stdio" | "streamable-http" | "sse"
  host: "127.0.0.1"
  port: 9000
  mount_path: "/mcp"

api:
  host: "127.0.0.1"
  port: 8000

redis:
  enabled: false
  host: "127.0.0.1"
  port: 6379
  db: 0
  password_env: "REDIS_PASSWORD"
  max_connections: 50
  socket_timeout: 5.0
  ttl_embedding: 604800
  ttl_retrieval: 3600
  cache:
    embedding_enabled: true
    retrieval_enabled: true
